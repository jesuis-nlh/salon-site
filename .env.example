# Copy to .env.local for local development. Never commit real values.

# Canonical production URL (no trailing slash). Used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.fr

# Appointment request form (/api/demande) — e-mail delivery through Resend (https://resend.com).
# While these are unset the form tells visitors plainly that their request was NOT sent.
RESEND_API_KEY=
# Inbox that receives the requests
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "Trame <rendez-vous@example.fr>"
CONTACT_FROM_EMAIL=
